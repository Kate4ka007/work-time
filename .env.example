# Скопируйте в .env и заполните значения (без кавычек вокруг значений!)

# Минимум 32 символа
NUXT_SESSION_PASSWORD=change-me-to-at-least-32-characters-long

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Authorized redirect URI: http://localhost:3000/auth/google
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Разрешённые email через запятую (пусто = любой Google-аккаунт)
NUXT_ALLOWED_EMAILS=your@gmail.com

# Redis на Vercel (Storage → Upstash for Redis или Redis → Connect to Project)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# — или —
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
